# Copy to .env (gitignored). Placeholders only. Never commit real secrets.

# --- network ---
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042

# --- contracts (filled from deployments/arc-mainnet.json after deploy) ---
COORDINATOR_ADDRESS=
FAIR_ALLOCATION_ADDRESS=
COORDINATOR_DEPLOY_BLOCK=

# --- deploy (Foundry) ---
# Preferred: an encrypted Foundry keystore, used as `forge script ... --account <name>`.
FOUNDRY_ACCOUNT=[KEYSTORE_ACCOUNT_NAME]

# --- relayer ---
# Signer for fulfill txs. Use a dedicated low-balance hot wallet.
RELAYER_PRIVATE_KEY=[RELAYER_PRIVATE_KEY]
DRAND_URLS=https://api.drand.sh,https://api2.drand.sh,https://drand.cloudflare.com
RELAYER_POLL_MS=1500
RELAYER_MIN_BOUNTY=0
RELAYER_MAX_GAS_PRICE_GWEI=100
RELAYER_STATE_FILE=services/relayer/.state/cursor.json
LOG_LEVEL=info

# --- web ---
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_COORDINATOR_ADDRESS=
NEXT_PUBLIC_FAIR_ALLOCATION_ADDRESS=
